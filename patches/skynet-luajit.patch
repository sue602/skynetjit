+++ b/lualib/skynet/service.lua
@@ -9,6 +9,9 @@ local function get_provider()
 end
 
 local function check(func)
+	if _VERSION == "Lua 5.1" then
+		return -- LuaJIT uses a function environment instead of an _ENV upvalue.
+	end
 	local info = debug.getinfo(func, "u")
 	assert(info.nups == 1)
 	assert(debug.getupvalue(func,1) == "_ENV")
